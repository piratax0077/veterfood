APP_NAME="Comercializadora Alimentos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TWO_FACTOR_BYPASS_EMAILS=adminalimentos@local.cl,administrador2@local.cl

# Escritorio principal al que vuelve el cliente desde Alimentos y Farmacia.
VET_SDI_WEB_URL=http://vet-sdi_v13.test:8080/Paciente/Inicio

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alimentos_mascotas
DB_USERNAME=root
DB_PASSWORD=
# En Google Cloud Run con Cloud SQL usa:
# DB_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RUN_MIGRATIONS=false
RUN_SEEDERS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# En local se registra como enviado sin contactar al tutor.
# Cambiar a true en el servidor cuando MAIL_* este configurado y probado.
PEDIDO_RECORDATORIO_DIAS=7
PEDIDO_RECORDATORIO_ENVIO_REAL=false

CONTABILIDAD_API_URL=http://contabilidad-api.test/api/v1
CONTABILIDAD_API_TOKEN=
CONTABILIDAD_CLIENTE_UUID=
CONTABILIDAD_WEB_URL=http://contabilidad-api.test
CONTABILIDAD_CONNECT_TIMEOUT=3
CONTABILIDAD_TIMEOUT=10
